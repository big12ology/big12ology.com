
# Local preview output — assemble.sh rebuilds it on demand.
dist/

# --- local agent + IDE state (machine-specific, never commit) ---
.claude/
.idea/
.DS_Store

# Python bytecode, anywhere. tiebreaker/.gitignore has covered its own tree
# since that was the only Python in the repo; the fixture generator under
# worker/ is not in that tree and was staging .pyc files.
__pycache__/
*.pyc

# --- backend credentials and local wrangler state (never commit) ---
# The pick'em Worker holds the OAuth client secrets and the identity pepper.
# .dev.vars is the local stand-in for `wrangler secret put`, in plaintext.
.dev.vars
.wrangler/
worker/node_modules/

# --- working notes: scratch, handoffs, plans (keep out of the repo) ---
/notes/
HANDOFF.md
PLAN.md
TODO.md
SCRATCH.md
*.wip.md

# Calls made by hand, counted by tools/api-budget.py. A local fact.
tiebreaker/data/.api-local.log
